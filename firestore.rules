rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owned(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Arquivo antigo: mantém regras restritas, mas o NEX novo não o utiliza.
    match /users/{userId}/characters/{characterId} {
      allow read: if owned(userId);
      allow create, update: if owned(userId)
        && request.resource.data.keys().hasOnly(['id','data','createdAt','updatedAt','format'])
        && request.resource.data.id == characterId
        && request.resource.data.data is map
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.format == 'nex-character-v1';
      allow delete: if false;
    }

    // Nova sincronização automática separada, com registros de exclusão.
    match /users/{userId}/nex_v3/{recordId} {
      allow read: if owned(userId);
      allow create, update: if owned(userId)
        && request.resource.data.keys().hasOnly(['type','payload','deleted','updatedAt'])
        && request.resource.data.type in ['agent','campaigns','homebrew']
        && request.resource.data.deleted is bool
        && request.resource.data.payload is map
        && request.resource.data.updatedAt is timestamp
        && (
          (request.resource.data.type == 'agent' && recordId.matches('agent-[A-Za-z0-9_-]{2,90}'))
          || (request.resource.data.type == 'campaigns' && recordId == 'campaigns')
          || (request.resource.data.type == 'homebrew' && recordId == 'homebrew')
        );
      allow delete: if false;
    }
    // Índice privado de campanhas aprovadas para cada jogador.
    match /users/{userId}/joinedCampaigns/{cid} {
      allow get, list: if owned(userId);
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['campaignId','gmUid','joinedAt'])
        && request.resource.data.campaignId == cid
        && request.resource.data.gmUid == request.auth.uid
        && exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(userId))
        && get(/databases/$(database)/documents/campaigns/$(cid)).data.gmUid == request.auth.uid;
      allow delete: if owned(userId) || (
        request.auth != null
        && get(/databases/$(database)/documents/campaigns/$(cid)).data.gmUid == request.auth.uid
      );
    }
    // Campanhas online: apenas participantes podem ler; apenas dono ou mestre editam fichas.
    function nexInCampaign(cid) {
      return request.auth != null && (
        get(/databases/$(database)/documents/campaigns/$(cid)).data.gmUid == request.auth.uid ||
        exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid))
      );
    }
    function nexGM(cid) {
      return request.auth != null &&
        get(/databases/$(database)/documents/campaigns/$(cid)).data.gmUid == request.auth.uid;
    }
    match /campaigns/{cid} {
      // Evita a chamada recursiva ao próprio documento durante a leitura.
      allow get: if request.auth != null && (
        resource.data.gmUid == request.auth.uid ||
        exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid))
      );
      // O Firestore permite a consulta somente quando filtrada pelo UID do mestre.
      // Nunca exponha todas as campanhas a usuários autenticados.
      allow list: if request.auth != null && resource.data.gmUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name','description','gmUid','privateShield','createdAt','updatedAt'])
        && request.resource.data.gmUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.privateShield is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if nexGM(cid)
        && request.resource.data.gmUid == resource.data.gmUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','privateShield','updatedAt','coverUrl','gmName','gmPhoto'])
        && (!request.resource.data.keys().hasAny(['coverUrl']) || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 390000))
        && (!request.resource.data.keys().hasAny(['gmName']) || (request.resource.data.gmName is string && request.resource.data.gmName.size() <= 60))
        && (!request.resource.data.keys().hasAny(['gmPhoto']) || (request.resource.data.gmPhoto is string && request.resource.data.gmPhoto.size() <= 115000));
      allow delete: if nexGM(cid);
      // Solicitações feitas por usuários autenticados que possuem um link de convite.
      // O convite não concede leitura das fichas nem entrada automática.
      match /joinRequests/{uid} {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','name','requestedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.requestedAt is timestamp;
        allow get: if request.auth != null
          && (request.auth.uid == uid || nexGM(cid));
        allow list: if nexGM(cid);
        allow delete: if request.auth != null
          && (request.auth.uid == uid || nexGM(cid));
        allow update: if false;
      }
      match /members/{uid} {
        allow get, list: if nexInCampaign(cid);
        allow create: if nexGM(cid)
          && request.resource.data.keys().hasOnly(['uid','name','joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string;
        allow update: if (nexGM(cid) || owned(uid))
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(nexGM(cid) ? ['name','photo','maxSheets'] : ['name','photo'])
          && (!request.resource.data.keys().hasAny(['maxSheets']) || (request.resource.data.maxSheets is int && request.resource.data.maxSheets >= 1 && request.resource.data.maxSheets <= 20))
          && (request.resource.data.name is string && request.resource.data.name.size() <= 60)
          && (!request.resource.data.keys().hasAny(['photo']) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 115000));
        allow delete: if nexGM(cid) || owned(uid);
      }
      // Pedidos individuais de vagas extras: só o Mestre autoriza.
      match /slotRequests/{playerUid} {
        allow create: if nexInCampaign(cid)
          && request.auth.uid == playerUid
          && exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(playerUid))
          && request.resource.data.keys().hasOnly(['uid','requestedAt'])
          && request.resource.data.uid == playerUid
          && request.resource.data.requestedAt is timestamp;
        allow get: if nexGM(cid) || owned(playerUid);
        allow list: if nexGM(cid);
        allow delete: if nexGM(cid);
        allow update: if false;
      }
      function allowedSlot(playerUid, sheetId) {
        return exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(playerUid))
          && request.resource.data.keys().hasAll(['slotNumber'])
          && request.resource.data.slotNumber is int
          && request.resource.data.slotNumber >= 1
          && request.resource.data.slotNumber <= get(/databases/$(database)/documents/campaigns/$(cid)/members/$(playerUid)).data.get('maxSheets',1)
          && sheetId == 'slot-' + playerUid + '-' + string(request.resource.data.slotNumber);
      }
      match /sheets/{sheetId} {
        allow get, list: if nexInCampaign(cid);
        allow create: if nexInCampaign(cid)
          && request.resource.data.keys().hasOnly(['ownerUid','controllerUid','slotNumber','name','nex','pv','pe','san','notes','updatedAt','fullSheet','linkedAgentId','sheetFormat'])
          && request.resource.data.ownerUid is string
          && (
            (nexGM(cid) && (
              request.resource.data.ownerUid == request.auth.uid ||
              exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.resource.data.ownerUid))
            )) ||
            (request.resource.data.ownerUid == request.auth.uid && allowedSlot(request.auth.uid,sheetId))
          )
          && (
            !request.resource.data.keys().hasAny(['controllerUid']) ||
            (nexGM(cid) && request.resource.data.controllerUid is string &&
             exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.resource.data.controllerUid)))
          )
          && request.resource.data.name is string
          && request.resource.data.nex is int
          && request.resource.data.pv is int
          && request.resource.data.pe is int
          && request.resource.data.san is int
          && request.resource.data.notes is string
          && (!request.resource.data.keys().hasAny(['fullSheet']) || (
             request.resource.data.fullSheet is map
             && request.resource.data.linkedAgentId is string
             && request.resource.data.sheetFormat == 'nex-agent-v1'
             && request.resource.data.ownerUid == request.auth.uid
          ));
        allow update: if nexInCampaign(cid)
          && (
            nexGM(cid) || resource.data.ownerUid == request.auth.uid ||
            resource.data.get('controllerUid','') == request.auth.uid
          )
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (
            nexGM(cid) ||
            (
              request.resource.data.get('controllerUid','') == resource.data.get('controllerUid','')
              && request.resource.data.get('slotNumber',0) == resource.data.get('slotNumber',0)
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','nex','pv','pe','san','notes','updatedAt','fullSheet','linkedAgentId','sheetFormat','controllerUid'])
          && (!request.resource.data.keys().hasAny(['controllerUid']) ||
              request.resource.data.controllerUid == request.resource.data.ownerUid ||
              request.resource.data.controllerUid == get(/databases/$(database)/documents/campaigns/$(cid)).data.gmUid ||
              exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.resource.data.controllerUid)))
          && request.resource.data.name is string
          && request.resource.data.nex is int
          && request.resource.data.pv is int
          && request.resource.data.pe is int
          && request.resource.data.san is int
          && request.resource.data.notes is string
          && (!request.resource.data.keys().hasAny(['fullSheet']) || (
             request.resource.data.fullSheet is map
             && request.resource.data.linkedAgentId is string
             && request.resource.data.sheetFormat == 'nex-agent-v1'
             && (request.resource.data.ownerUid == request.auth.uid ||
                 resource.data.get('controllerUid','') == request.auth.uid || nexGM(cid))
          ));
        allow delete: if nexGM(cid);
      }
      match /combats/{combatId} {
        allow get, list: if nexInCampaign(cid);
        allow create: if nexGM(cid)
          && request.resource.data.keys().hasOnly(['name','status','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.status == 'Preparação'
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if nexGM(cid);
      }
      match /combats/{combatId}/rolls/{rollId} {
        allow get, list: if nexInCampaign(cid);
        allow create: if nexInCampaign(cid)
          && request.resource.data.keys().hasOnly(['ownerUid','sheetId','characterName','result','createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.sheetId is string
          && (get(/databases/$(database)/documents/campaigns/$(cid)/sheets/$(request.resource.data.sheetId)).data.ownerUid == request.auth.uid ||
           get(/databases/$(database)/documents/campaigns/$(cid)/sheets/$(request.resource.data.sheetId)).data.get('controllerUid','') == request.auth.uid)
          && request.resource.data.characterName is string
          && request.resource.data.characterName.size() <= 100
          && request.resource.data.result is int
          && request.resource.data.result >= 1 && request.resource.data.result <= 20
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
            match /masterNotes/{noteId} {
        allow read, write: if nexGM(cid);
      }
    }

  }
}
