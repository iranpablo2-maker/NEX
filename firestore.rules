rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owned(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Arquivo antigo: mantém regras restritas, mas o NEX novo não o utiliza.
    match /users/{userId}/characters/{characterId} {
      allow read: if owned(userId);
      allow create, update: if owned(userId)
        && request.resource.data.keys().hasOnly(['id','data','createdAt','updatedAt','format'])
        && request.resource.data.id == characterId
        && request.resource.data.data is map
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.format == 'nex-character-v1';
      allow delete: if false;
    }

    // Nova sincronização automática separada, com registros de exclusão.
    match /users/{userId}/nex_v3/{recordId} {
      allow read: if owned(userId);
      allow create, update: if owned(userId)
        && request.resource.data.keys().hasOnly(['type','payload','deleted','updatedAt'])
        && request.resource.data.type in ['agent','campaigns','homebrew']
        && request.resource.data.deleted is bool
        && request.resource.data.payload is map
        && request.resource.data.updatedAt is timestamp
        && (
          (request.resource.data.type == 'agent' && recordId.matches('agent-[A-Za-z0-9_-]{2,90}'))
          || (request.resource.data.type == 'campaigns' && recordId == 'campaigns')
          || (request.resource.data.type == 'homebrew' && recordId == 'homebrew')
        );
      allow delete: if false;
    }
    // Campanhas online: apenas participantes podem ler; apenas dono ou mestre editam fichas.
    function nexInCampaign(cid) {
      return request.auth != null && (
        get(/databases/$(database)/documents/campaigns/$(cid)).data.gmUid == request.auth.uid ||
        exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid))
      );
    }
    function nexGM(cid) {
      return request.auth != null &&
        get(/databases/$(database)/documents/campaigns/$(cid)).data.gmUid == request.auth.uid;
    }
    match /campaigns/{cid} {
      // Evita a chamada recursiva ao próprio documento durante a leitura.
      allow get: if request.auth != null && (
        resource.data.gmUid == request.auth.uid ||
        exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid))
      );
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name','description','gmUid','createdAt'])
        && request.resource.data.gmUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string;
      allow update: if nexGM(cid)
        && request.resource.data.gmUid == resource.data.gmUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description']);
      allow delete: if nexGM(cid);
      // Solicitações feitas por usuários autenticados que possuem um link de convite.
      // O convite não concede leitura das fichas nem entrada automática.
      match /joinRequests/{uid} {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','name','requestedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.requestedAt is timestamp;
        allow get: if request.auth != null
          && (request.auth.uid == uid || nexGM(cid));
        allow list: if nexGM(cid);
        allow delete: if request.auth != null
          && (request.auth.uid == uid || nexGM(cid));
        allow update: if false;
      }
      match /members/{uid} {
        allow get, list: if nexInCampaign(cid);
        allow create: if nexGM(cid)
          && request.resource.data.keys().hasOnly(['uid','name','joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string;
        allow update: if nexGM(cid)
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
        allow delete: if nexGM(cid);
      }
      match /sheets/{sheetId} {
        allow get, list: if nexInCampaign(cid);
        allow create: if nexInCampaign(cid)
          && request.resource.data.keys().hasOnly(['ownerUid','name','nex','pv','pe','san','notes','updatedAt'])
          && request.resource.data.ownerUid is string
          && (
            request.resource.data.ownerUid == request.auth.uid ||
            (nexGM(cid) && exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.resource.data.ownerUid)))
          )
          && request.resource.data.name is string
          && request.resource.data.nex is int
          && request.resource.data.pv is int
          && request.resource.data.pe is int
          && request.resource.data.san is int
          && request.resource.data.notes is string;
        allow update: if nexInCampaign(cid)
          && (resource.data.ownerUid == request.auth.uid || nexGM(cid))
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','nex','pv','pe','san','notes','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.nex is int
          && request.resource.data.pv is int
          && request.resource.data.pe is int
          && request.resource.data.san is int
          && request.resource.data.notes is string;
        allow delete: if nexInCampaign(cid) && (resource.data.ownerUid == request.auth.uid || nexGM(cid));
      }
      match /masterNotes/{noteId} {
        allow read, write: if nexGM(cid);
      }
    }

  }
}
